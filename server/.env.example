PORT=3000
# Production: Render uses RENDER_EXTERNAL_URL automatically. Set APP_ORIGIN to
# override it for a custom public HTTPS origin or another hosting provider.
APP_ORIGIN=http://localhost:3000
# Omit CLIENT_ORIGIN for same-origin production; development defaults to Vite :5173.
# CLIENT_ORIGIN=http://localhost:5173
# COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=example.com
# TRUST_PROXY=1
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/chat-app
JWT_SECRET_KEY=replace_with_a_long_random_secret
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
